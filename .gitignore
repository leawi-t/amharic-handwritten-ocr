# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.env
.mypy_cache/
.pytest_cache/

# ===== Flutter (see also mobile/.gitignore) =====
.dart_tool/
**/build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ===== Machine learning artifacts =====
# Trained model weights (large binary files should not be committed;
# use a release, cloud storage, or Git LFS instead)
ml/models/*
!ml/models/.gitkeep
*.pt
*.pth
*.onnx
*.h5
*.ckpt

# ===== Datasets =====
# Raw and processed data should not be committed to the repo.
# Document how to obtain the Fidel dataset in ml/README.md instead.

ml/data/*
!ml/data/processed/
!ml/data/processed/.gitkeep
# Small lexical resource that is intentionally tracked (check its licence in ml/docs/datasheet.md)
!ml/data/raw/
ml/data/raw/*
!ml/data/raw/amharic_wordlist.txt
# ===== Jupyter =====
.ipynb_checkpoints/

# ===== OS / Editor =====
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===== Build outputs =====
dist/
build/
*.log

# ===== Office / report drafts =====
# Word and LibreOffice lock files created while a document is open
~$*
.~lock.*#
